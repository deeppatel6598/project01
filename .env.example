# Tablekit — copy to `.env.local` and fill in.
# See docs/DEPLOYMENT.md for where each value comes from.

# ── database (required) ────────────────────────────────────────────────────

# Supabase → Project Settings → Database → Connection string →
# **Transaction pooler** (host ends .pooler.supabase.com, port 6543).
#
# Not the direct connection (db.<ref>.supabase.co) — that is IPv6-only and
# unreachable from a serverless function. Not the session pooler either: it
# holds one server connection per client and cold starts exhaust the pool.
DATABASE_URL=

# Set to "disable" only for a local Postgres without TLS.
# DATABASE_SSL=disable

# ── secrets (required in production) ───────────────────────────────────────

# Signs staff session cookies and keys the IP hash in the rate-limit log.
# The app REFUSES TO START in production without this — a public default
# would let anyone mint themselves a staff session.
#   Generate with:  openssl rand -base64 32
TABLEKIT_SECRET=

# ── public URL ─────────────────────────────────────────────────────────────

# The origin printed into QR codes. Set this in production: behind a proxy the
# request Host header can be an internal name, and a sticker printed with the
# wrong URL is scrap paper.
# TABLEKIT_PUBLIC_ORIGIN=https://orderat.netlify.app

# ── realtime ───────────────────────────────────────────────────────────────

# "off" stops the kitchen board attempting SSE. Set automatically on Netlify
# via netlify.toml, because functions cannot hold a stream open and the board
# would retry forever. Leave unset on a long-lived server to get true realtime.
# NEXT_PUBLIC_TABLEKIT_STREAM=off

# ── seeding ────────────────────────────────────────────────────────────────

# The owner account `npm run seed` creates.
# TABLEKIT_OWNER_EMAIL=owner@roastandtoast.test
# TABLEKIT_OWNER_PASSWORD=

# Also apply Row Level Security when seeding (Supabase only).
# TABLEKIT_APPLY_RLS=1

# ── tests ──────────────────────────────────────────────────────────────────

# Any throwaway Postgres. The suite runs against a real server, not a mock.
#   docker run -e POSTGRES_HOST_AUTH_METHOD=trust -p 5433:5432 -d postgres:16
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres
